# Public web configuration
PUBLIC_SITE_URL=https://relustt.site
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase access (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Stripe values will be supplied separately
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me
# Funnel: active USD 29.50 recurring Price, every 1 month, per-unit/licensed.
# The selected $5/$9/$13/$17.67 first-week charge is created server-side.
STRIPE_PRICE_FUNNEL_MONTHLY=price_replace_me

# Labels shown before Stripe Checkout. Stripe remains the source of truth
# for actual legacy direct-plan prices and recurring intervals.
WEB_PLAN_MONTHLY_LABEL=Monthly plan
WEB_PLAN_YEARLY_LABEL=Yearly plan
